{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 27, "patch": 0 },
  "configurePresets": [
    {
      "name": "hip-gfx942-base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "QUASAR_ENABLE_HIP": "ON",
        "CMAKE_HIP_ARCHITECTURES": "gfx942",
        "QUASAR_BUILD_TESTING": "ON",
        "QUASAR_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "hip-gfx942-release",
      "displayName": "HIP gfx942 Release",
      "inherits": "hip-gfx942-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "hip-gfx942-debug",
      "displayName": "HIP gfx942 Debug",
      "inherits": "hip-gfx942-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "hip-gfx950-base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "QUASAR_ENABLE_HIP": "ON",
        "CMAKE_HIP_ARCHITECTURES": "gfx950",
        "QUASAR_BUILD_TESTING": "ON",
        "QUASAR_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "hip-gfx950-release",
      "displayName": "HIP gfx950 Release",
      "inherits": "hip-gfx950-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "hip-gfx950-debug",
      "displayName": "HIP gfx950 Debug",
      "inherits": "hip-gfx950-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "hip-gfx942-release", "configurePreset": "hip-gfx942-release" },
    { "name": "hip-gfx942-debug",   "configurePreset": "hip-gfx942-debug"   },
    { "name": "hip-gfx950-release", "configurePreset": "hip-gfx950-release" },
    { "name": "hip-gfx950-debug",   "configurePreset": "hip-gfx950-debug"   }
  ],
  "testPresets": [
    {
      "name": "default-fast",
      "hidden": true,
      "description": "Excludes tests labelled 'slow' (python_test_examples, >1h).",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "slow" } }
    },
    {
      "name": "default-all",
      "hidden": true,
      "description": "Every test, including those labelled 'slow'.",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "hip-gfx942-release",
      "configurePreset": "hip-gfx942-release",
      "inherits": "default-fast"
    },
    {
      "name": "hip-gfx942-release-all",
      "displayName": "HIP gfx942 Release (including slow tests)",
      "configurePreset": "hip-gfx942-release",
      "inherits": "default-all"
    },
    {
      "name": "hip-gfx942-debug",
      "configurePreset": "hip-gfx942-debug",
      "inherits": "default-fast"
    },
    {
      "name": "hip-gfx942-debug-all",
      "displayName": "HIP gfx942 Debug (including slow tests)",
      "configurePreset": "hip-gfx942-debug",
      "inherits": "default-all"
    },
    {
      "name": "hip-gfx950-release",
      "configurePreset": "hip-gfx950-release",
      "inherits": "default-fast"
    },
    {
      "name": "hip-gfx950-release-all",
      "displayName": "HIP gfx950 Release (including slow tests)",
      "configurePreset": "hip-gfx950-release",
      "inherits": "default-all"
    },
    {
      "name": "hip-gfx950-debug",
      "configurePreset": "hip-gfx950-debug",
      "inherits": "default-fast"
    },
    {
      "name": "hip-gfx950-debug-all",
      "displayName": "HIP gfx950 Debug (including slow tests)",
      "configurePreset": "hip-gfx950-debug",
      "inherits": "default-all"
    }
  ]
}
